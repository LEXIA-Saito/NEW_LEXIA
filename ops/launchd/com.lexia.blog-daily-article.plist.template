<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for the daily LEXIA blog article generator.
  Do NOT install this file directly — run scripts/blog/install-launchd.sh, which
  fills the __PLACEHOLDERS__ with absolute paths discovered on this machine and
  copies the result to ~/Library/LaunchAgents/. No credentials live in this file.

  Schedule: 09:00 in the Mac's LOCAL time. Keep the Mac's timezone on JST (or adjust
  the Hour) so generation fires at 09:00 JST.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lexia.blog-daily-article</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>exec "__SCRIPT__"</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__STDERR__</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
